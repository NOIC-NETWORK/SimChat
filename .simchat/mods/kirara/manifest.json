{
  "$schema": "../../spec/mod-manifest.schema.json",
  "id": "kirara",
  "type": "skill",
  "layer": "mod",
  "name": "Kirara行为包",
  "description": "Kirara 行为包：以 MOD 形式接入 JRVS 内核与 Kirara Flask 服务，提供女仆人设、主题资源、kirara.trivia 方块，以及装备 orbiter 的只读地图（AI 实例）。",
  "version": "0.4.0",
  "abi": "simchat-mod/2",
  "entry": "kirara_entry:register",
  "frontend_entry": "web/index.html",
  "desktop": {
    "pet": {
      "sprite": "sprites/characters/kirara/common/kirara-common-default.png",
      "page": "web/index.html",
      "height": 480,
      "entry": "python/pet_window.py"
    }
  },
  "hooks": [
    "agent.block",
    "agent.map",
    "web.blueprint"
  ],
  "capabilities": {
    "fs": {
      "read": [
        "package"
      ],
      "write": [
        "mod-data"
      ]
    },
    "net": {
      "domains": [
        "dashscope.aliyuncs.com",
        "open.bigmodel.cn"
      ]
    },
    "shell": true
  },
  "requires": {
    "simchat": ">=2.0,<3",
    "python": ">=3.9",
    "packages": [
      "flask",
      "requests",
      "bs4",
      "chromadb",
      "sentence_transformers",
      "importlib_metadata",
      "pyautogui",
      "pyttsx3"
    ]
  },
  "license": "MIT",
  "config": {
    "persona": "maid",
    "system_prompt_file": "prompts/maid.txt",
    "theme": "css/theme.css",
    "params": {
      "think_mode": "medium"
    },
    "models": {
      "primary": "jrvs",
      "role": "local_primary",
      "label": "JRVS-7B-1.2.2 \"Puff\"",
      "why": [
        "人格原生：system=\"Kirara\" 直接触发女仆人设，不需要额外拼长提示词",
        "常驻在线：桌宠与 IM 入口长期可用，模型以 keep_alive 驻留本地服务",
        "本地推理：Ollama + CUDA 全层卸载，日常对话数据不出本机",
        "润色定位：System 2 草稿/反思后，由 System 1（JRVS）润色成人设口吻",
        "编排定位：轻量本地模型负责任务分诊与提示词补全，复杂任务再交给 Orbiter/云端"
      ],
      "persona_system": "Kirara",
      "runtime": {
        "backend": "ollama",
        "model": "televideo-ai/JRVS-7B-1.2.2:latest",
        "context_window": 16384,
        "gpu_layers": 99,
        "kv_cache": "q8",
        "keep_alive": "30m"
      },
      "roles": {
        "chat": "active",
        "polish": "active",
        "orchestrate": "planned"
      },
      "status": "declared_not_wired",
      "not_implemented": [
        "尚未接入 SimChat 宿主的 inference 服务，也没有以 ToolSpec 暴露可调用的 jrvs.* 方块",
        "Orbiter / router 未实现，chat_with_router_details 的 routing_info 目前固定为 null",
        "云端模型与凭据未纳入本行为包配置"
      ]
    }
  }
}
