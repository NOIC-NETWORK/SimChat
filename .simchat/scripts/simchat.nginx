# ---------------------------------------------------------------------------
# Basic Auth 示例（SimChat 无内置鉴权时至少加一层）
# ---------------------------------------------------------------------------
#   sudo htpasswd -c /etc/nginx/.simchat_htpasswd youruser
#   然后在 location / 中加入：
#     auth_basic           "SimChat";
#     auth_basic_user_file /etc/nginx/.simchat_htpasswd;
#
# 注意：Basic Auth 必须配合 HTTPS，否则凭据会明文传输。
