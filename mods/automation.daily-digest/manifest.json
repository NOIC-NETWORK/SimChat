  "version": "0.1.0",
  "abi": "lmbrew-mod/1",
  "entry": "flow.json",
  "hooks": ["agent.completed"],
  "capabilities": {
    "schedule": true
  },
  "requires": {
    "lmbrew": ">=2.1,<3",
    "python": ">=3.9"
  },
  "license": "MIT",
  "automation": {
    "flow_file": "flow.json"
  }
}
