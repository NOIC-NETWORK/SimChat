{
  "id": "noic.skill-readfile",
  "type": "skill",
  "name": "ReadFile 文件读取技能",
  "description": "读取用户上传的文件内容，支持文本/PDF/Word/Excel/图片元数据等多种格式",
  "version": "1.0.0",
  "abi": "lmbrew-mod/1",
  "entry": "readFile:register",
  "hooks": [
    "agent.tool"
  ],
  "capabilities": {
    "fs": {
      "read": [
        "workspace"
      ]
    }
  },
  "requires": {
    "lmbrew": ">=2.0,<3",
    "python": ">=3.9"
  },
  "license": "proprietary"
}