{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simchat.dev/spec/registry.schema.json",
  "title": "SimChat Registry Index",
  "type": "object",
  "required": ["version", "updated_at", "abi", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "abi": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/Entry" }
    }
  },
  "$defs": {
    "Entry": {
      "type": "object",
      "required": ["mod_id", "type", "name", "license", "publisher", "versions"],
      "additionalProperties": false,
      "properties": {
        "mod_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "type": {
          "enum": ["agent-config", "skill", "automation", "binary"]
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "publisher": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Version" }
        }
      }
    },
    "Version": {
      "type": "object",
      "required": ["version", "abi", "download", "published_at"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "abi": { "type": "string", "const": "lmbrew-mod/1" },
        "requires": { "type": "object" },
        "download": {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "enum": ["git-path", "git-tag", "release-zip", "direct"] },
            "url": { "type": "string" },
            "path": { "type": "string" },
            "ref": { "type": "string" },
            "checksum": { "type": "string" }
          }
        },
        "manifest_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{40,}$" },
        "capabilities": { "type": "object" },
        "published_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "downloads": { "type": "integer", "minimum": 0 },
        "deprecated": { "type": "boolean" }
      }
    }
  }
}
